{
  "name": "twls",
  "displayName": "twls",
  "description": "Manage ThingWorx services from VS Code.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.108.1"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "url": "http://192.168.7.101/team-project-3-reborn/twls"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "category": "TWLS",
        "command": "twls.init",
        "title": "Initialize"
      },
      {
        "category": "TWLS",
        "command": "twls.pull",
        "title": "Pull",
        "icon": "$(repo-pull)"
      },
      {
        "category": "TWLS",
        "command": "twls.pullProject",
        "title": "Pull Project",
        "icon": "$(repo-pull)"
      },
      {
        "category": "TWLS",
        "command": "twls.push",
        "title": "Push",
        "icon": "$(repo-push)"
      },
      {
        "category": "TWLS",
        "command": "twls.switchEntity",
        "title": "Switch Entity",
        "icon": "$(arrow-swap)"
      },
      {
        "category": "TWLS",
        "command": "twls.discard",
        "title": "Discard",
        "icon": "$(discard)"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "twls.pull",
          "group": "navigation",
          "when": "scmProvider == twls"
        },
        {
          "command": "twls.push",
          "group": "navigation",
          "when": "scmProvider == twls"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "twls.discard",
          "group": "inline",
          "when": "scmProvider == twls"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "package": "vsce package --skip-license"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.108.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "eslint": "^9.39.2",
    "prettier": "3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0"
  },
  "dependencies": {
    "zod": "^4.3.6"
  }
}
