{
  "name": "twls",
  "displayName": "ThingWorx Local Service",
  "publisher": "cadit-iot-centre",
  "description": "Manage ThingWorx services from VS Code.",
  "version": "0.0.2",
  "engines": {
    "vscode": "^1.108.1"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "http://192.168.7.101/team-project-3-reborn/twls.git"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "commands": [
      {
        "category": "TWLS",
        "command": "twls.init",
        "title": "Initialize"
      },
      {
        "category": "TWLS",
        "command": "twls.pull",
        "title": "Pull",
        "icon": "$(repo-pull)"
      },
      {
        "category": "TWLS",
        "command": "twls.pullProject",
        "title": "Pull Project",
        "icon": "$(repo-pull)"
      },
      {
        "category": "TWLS",
        "command": "twls.push",
        "title": "Push",
        "icon": "$(repo-push)"
      },
      {
        "category": "TWLS",
        "command": "twls.switchEntity",
        "title": "Switch Entity",
        "icon": "$(arrow-swap)"
      },
      {
        "category": "TWLS",
        "command": "twls.discard",
        "title": "Discard",
        "icon": "$(discard)"
      },
      {
        "command": "twls.stash",
        "title": "TWLS: Stash Changes"
      },
      {
        "command": "twls.stashList",
        "title": "TWLS: Stash List"
      },
      {
        "command": "twls.stashApply",
        "title": "TWLS: Stash Apply (Latest)"
      },
      {
        "command": "twls.stashPop",
        "title": "TWLS: Stash Pop (Latest)"
      },
      {
        "command": "twls.showOutput",
        "title": "TWLS: Show Output"
      },
      {
        "command": "twls.newService",
        "title": "TWLS: New Service"
      },
      {
        "command": "twls.callService",
        "title": "TWLS: Call Service"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "twls.pull",
          "group": "navigation",
          "when": "scmProvider == twls"
        },
        {
          "command": "twls.push",
          "group": "navigation",
          "when": "scmProvider == twls"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "twls.discard",
          "group": "inline",
          "when": "scmProvider == twls"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "test": "mocha --ui tdd --timeout 10000 \"out/test/unit/*.test.js\"",
    "pretest:extension": "npm run compile && npm run lint",
    "test:extension": "vscode-test",
    "lint": "eslint src",
    "package": "vsce package --skip-license",
    "build:webview": "vite build --config webview/vite.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/js-yaml": "^4.0.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/react": "^19.x",
    "@types/react-dom": "^19.x",
    "@types/vscode": "^1.108.1",
    "@vitejs/plugin-react": "^5.x",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "eslint": "^9.39.2",
    "mocha": "^11.7.4",
    "prettier": "3.8.1",
    "react": "^19.x",
    "react-dom": "^19.x",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0",
    "vite": "^7.x"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "js-yaml": "^5.4.2",
    "zod": "^4.3.6"
  }
}
